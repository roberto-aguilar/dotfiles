#!/bin/bash

# Gaming fixes for a workstation running the NVIDIA proprietary driver
# on the Hyprland Wayland compositor. Omarchy already sets the driver
# environment Wayland needs. This script adds the compositor rules games
# want (tearing, adaptive sync, fullscreen for games that do not take it
# themselves), a performance CPU governor during play, an in-game frame
# rate overlay, a GPU driver that stays resident between sessions, and
# game data that stays in RAM instead of being paged out to the SSD.
# All fixes are idempotent.

set -eu

DOTFILES_DIRECTORY="$(git rev-parse --show-toplevel)"

# Reshape Hyprland's presentation pipeline for gaming. Omarchy already
# makes Steam windows opaque and leaves direct scanout off, so only the
# rules Omarchy does not ship go here.
HYPRLAND_LUA="${HOME}/.config/hypr/hyprland.lua"
grep -qF 'dotfiles: gaming on NVIDIA' "${HYPRLAND_LUA}" 2>/dev/null || cat >>"${HYPRLAND_LUA}" <<'LUA'

-- dotfiles: gaming on NVIDIA.
-- Let games opt out of compositor vsync for lower input lag, and use the
-- monitor's adaptive sync only while a fullscreen app owns the screen.
hl.config({
  general = { allow_tearing = true },
  misc = { vrr = 2 },
})

-- Steam games take the tear-capable presentation path enabled above.
o.window("^steam_app_", { immediate = true })

-- DOOM Eternal opens a launcher window next to the game window and never
-- takes fullscreen on its own. Fullscreen the game window, not the launcher.
o.window({ class = "^steam_app_782330$", title = "DOOMEternal" }, { fullscreen = true })
LUA

# Have the CPU run at its performance governor automatically whenever a
# game is launched (so we never ship a game running on "powersave"),
# surface frame-rate and frame-time inside the game itself so stutter is
# visible at a glance, and provide the VDF parser the Steam launch-options
# script depends on.
sudo pacman -S --noconfirm --needed gamemode lib32-gamemode mangohud lib32-mangohud python-vdf

# Wire gamemode and mangohud into every installed Steam game's launch
# command, so activation is automatic and not a per-game chore.
"${DOTFILES_DIRECTORY}/arch/steam-launch-options"

# Keep the GPU driver resident between game sessions. Without this, each
# game launch pays the full driver initialization cost as a visible
# startup stall on the first frame.
sudo systemctl enable --now nvidia-persistenced

# Keep game data resident in RAM rather than paged out to the SSD. The
# kernel's default swappiness assumes a small-RAM machine that should
# evict pages proactively; with 64 GB installed there is enough headroom
# to hold everything in memory and avoid mid-session SSD stalls.
sudo tee /etc/sysctl.d/99-gaming.conf >/dev/null <<'SYSCTL'
vm.swappiness=10
SYSCTL
sudo sysctl --system >/dev/null

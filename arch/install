#!/bin/bash

# `-e` Exit on error.
# `-u` Treat unset variables as an error.
set -eu

# Determine the dotfiles directory.
DOTFILES_DIRECTORY="$(git rev-parse --show-toplevel)"

# Install Laravel development environment.
if [ -x "${HOME}/.local/share/omarchy/bin/omarchy-install-dev-env" ]; then
  "${HOME}/.local/share/omarchy/bin/omarchy-install-dev-env" laravel
fi

# Run the 1440p monitors at 1x scale and pin them to 144Hz.
MONITORS_LUA="${HOME}/.config/hypr/monitors.lua"
if [ -f "${MONITORS_LUA}" ]; then
  sed -i \
    -e 's/^local omarchy_gdk_scale = .*/local omarchy_gdk_scale = 1/' \
    -e 's/^local omarchy_monitor_scale = .*/local omarchy_monitor_scale = 1/' \
    "${MONITORS_LUA}"
  grep -qF 'desc:LG Electronics LG ULTRAGEAR' "${MONITORS_LUA}" || cat >>"${MONITORS_LUA}" <<'LUA'

-- dotfiles: pin every LG UltraGear panel to 1440p at 144Hz at 1x scale.
hl.monitor({ output = "desc:LG Electronics LG ULTRAGEAR", mode = "2560x1440@144", position = "auto", scale = omarchy_monitor_scale })
LUA
fi

# Use US and Spanish keyboard layouts, switched with Left Alt + Right Alt.
INPUT_LUA="${HOME}/.config/hypr/input.lua"
grep -qF 'kb_layout = "us,es"' "${INPUT_LUA}" 2>/dev/null || cat >>"${INPUT_LUA}" <<'LUA'

-- dotfiles: US and Spanish layouts, switched with Left Alt + Right Alt.
hl.config({
  input = {
    kb_layout = "us,es",
    kb_options = "compose:caps,shift:both_capslock_cancel,grp:alts_toggle",
  },
})
LUA

# Keep the desktop awake: no screensaver and no idle lock.
omarchy toggle idle stay-awake

# Install AUR Packages.
applications=(
  jetbrains-toolbox
  lmstudio-bin
  slack-desktop
)
for application in "${applications[@]}"; do
  yay -S --noconfirm --needed "${application}"
done
unset application
unset applications

# Install the .NET SDK for C# development.
sudo pacman -S --noconfirm --needed dotnet-sdk

# Install the Circleback CLI for terminal access to meeting notes.
if ! command -v circleback >/dev/null 2>&1; then
  npm install -g @circleback/cli
fi

# Install Railway CLI for deploying and managing Railway services.
if ! command -v railway >/dev/null 2>&1; then
  bash <(curl -fsSL cli.new)
fi

# Install OpenAI Codex CLI so the `co` alias has a binary to call.
omarchy-pkg-add openai-codex

# Install GitHub Copilot CLI for terminal-based agentic coding.
omarchy-pkg-add github-copilot-cli

# Install Google Gemini CLI for terminal-based agentic coding.
omarchy-pkg-add gemini-cli

# Install Web Applications
web_applications=(
  "Claude|https://claude.ai/new|https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/claude-ai-light.png"
  "Todoist|https://app.todoist.com/app/today|https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/todoist.png"
)
for web_application in "${web_applications[@]}"; do
  IFS='|' read -r name url icon <<<"${web_application}"
  omarchy-webapp-install "${name}" "${url}" "${icon}"
done
unset web_application
unset web_applications

# Enable SSH daemon for incoming connections.
sudo systemctl enable --now sshd

# Enable SSH agent via systemd for passphrase caching.
systemctl --user enable --now ssh-agent.socket

# Auto-add SSH keys to the agent on first use.
mkdir -p "${HOME}/.ssh" && chmod 700 "${HOME}/.ssh"
touch "${HOME}/.ssh/config" && chmod 600 "${HOME}/.ssh/config"
if ! grep -q "AddKeysToAgent" "${HOME}/.ssh/config"; then
  printf '\nHost *\n  AddKeysToAgent yes\n' >>"${HOME}/.ssh/config"
fi

# Source custom bash aliases.
ALIASES_SOURCE="source \"${DOTFILES_DIRECTORY}/arch/bash/aliases\""
grep -qF "${ALIASES_SOURCE}" "${HOME}/.bashrc" 2>/dev/null || echo "${ALIASES_SOURCE}" >>"${HOME}/.bashrc"

# Install delta for syntax-highlighted diffs with line numbers.
sudo pacman -S --noconfirm --needed git-delta

# Install stow for managing dotfile symlinks.
sudo pacman -S --noconfirm --needed stow

# Install lazygit configuration file.
stow -d "${DOTFILES_DIRECTORY}/arch" -t "${HOME}" lazygit

# Stow NeoVim configuration (hidden files, etc.).
stow -d "${DOTFILES_DIRECTORY}/arch" -t "${HOME}" nvim

# Point SSH_AUTH_SOCK at the systemd SSH agent for the whole uwsm session.
stow -d "${DOTFILES_DIRECTORY}/arch" -t "${HOME}" uwsm


# Apply Bluetooth audio fixes for the onboard WiFi/BT card.
"${DOTFILES_DIRECTORY}/arch/bluetooth-audio-rtl8821ce"

# Apply gaming fixes for this NVIDIA + Hyprland workstation.
"${DOTFILES_DIRECTORY}/arch/gaming-nvidia-hyprland"

LAZYVIM_JSON="${HOME}/.config/nvim/lazyvim.json"
if [ -f "${LAZYVIM_JSON}" ]; then
  jq '.extras |= (. + [
    "lazyvim.plugins.extras.dap.core",
    "lazyvim.plugins.extras.lang.dotnet",
    "lazyvim.plugins.extras.lang.php",
    "lazyvim.plugins.extras.lang.typescript",
    "lazyvim.plugins.extras.lang.vue",
    "lazyvim.plugins.extras.formatting.prettier",
    "lazyvim.plugins.extras.linting.eslint"
  ] | unique)' "${LAZYVIM_JSON}" > "${LAZYVIM_JSON}.tmp" && mv "${LAZYVIM_JSON}.tmp" "${LAZYVIM_JSON}"
fi
